viewClade(archaea_rooted_text, 2573)
## create dataframe to view ASVs and taxa info and to pull the ASVs
node2573 <- offspring(tree_tib, 2573, tiponly = TRUE) %>%
as.data.frame() %>% pull(label)
node2573_df <- as.data.frame(archaea_root_physeq@tax_table) %>% filter(ASV %in% node3316) %>% filter(Kingdom == "Bacteria" | is.na(Kingdom))
node2573_df <- as.data.frame(archaea_root_physeq@tax_table) %>% filter(ASV %in% node2573) %>% filter(Kingdom == "Bacteria" | is.na(Kingdom))
